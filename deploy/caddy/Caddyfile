# Caddy: TLS terminator, static UI server and reverse proxy (ADR-0011).
# Exposes only: the UI, /api/*, /ws and /actuator/health. Every other /actuator path is 404.
# Environment (set by compose): DOMAIN, REDIRECT_HOSTS, APP_UPSTREAMS (default "app:8080"; Phase 4 adds a second instance),
# HSTS_SNIPPET ("hsts" in production, "nohsts" for local https://localhost so the browser doesn't pin localhost).

(hsts) {
	# No preload: this is a demo domain, and preload is hard to undo.
	header Strict-Transport-Security "max-age=31536000"
}

(nohsts) {
}

# ACME_MODE (ADR-0011): "staging" uses the Let's Encrypt STAGING CA (browsers distrust it, but it has no
# production rate limits), for the first start on a new host until DNS and ports are confirmed.
# "default" uses Caddy's normal issuers (Let's Encrypt, with ZeroSSL as Caddy's fallback). For "localhost"
# Caddy always uses its own local CA.
(tls_staging) {
	tls {
		ca https://acme-staging-v02.api.letsencrypt.org/directory
	}
}

(tls_default) {
}

# Old and alternative names (REDIRECT_HOSTS, space-separated; compose defaults it to "www.<DOMAIN>") get a
# certificate too, and a permanent 308 redirect to the one canonical origin, so old links keep working and the
# app only ever sees Origin https://<DOMAIN> (the only allowed origin).
{$REDIRECT_HOSTS} {
	import tls_{$ACME_MODE:default}
	redir https://{$DOMAIN}{uri} 308
}

{$DOMAIN} {
	encode zstd gzip

	# Access log on stdout, WITHOUT secrets: the one-time WebSocket ticket in /ws?ticket=... is deleted from
	# the logged URI; Cookie, Authorization and Set-Cookie are dropped.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete ticket
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}

	import {$HSTS_SNIPPET:hsts}
	import tls_{$ACME_MODE:default}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Message bodies render as text; the CSP is defence in depth against any HTML injection.
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$DOMAIN}; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Caddy replaces any client-sent X-Forwarded-For with the real peer address (it trusts no upstream proxy),
	# so the app's per-IP rate limits can't be dodged by spoofing the header (smoke.sh checks this).
	handle /actuator/health {
		reverse_proxy {$APP_UPSTREAMS:app:8080}
	}
	handle /actuator* {
		respond 404
	}
	handle /api/* {
		reverse_proxy {$APP_UPSTREAMS:app:8080}
	}
	handle /ws {
		reverse_proxy {$APP_UPSTREAMS:app:8080}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
