# LOCAL ONLY: the compose stack on https://localhost (Caddy's local CA; your browser will warn once).
# These values are public and for this laptop only. `cp .env.local.example .env` in deploy/.
DOMAIN=localhost
APP_IMAGE=chat-app
WEB_IMAGE=chat-web
IMAGE_TAG=local
# No HSTS on localhost: it would pin every localhost port to HTTPS in your browser for a year.
HSTS_SNIPPET=nohsts

POSTGRES_PASSWORD=local-only-postgres-password
JWT_SECRET=local-only-jwt-secret-for-the-compose-stack-0123456789
REGISTRATION_INVITE_CODE=local-invite
DEMO_PASSWORD=local-demo-password
