# Production environment for deploy/compose.yml. Copy to /opt/chat/.env on the server, fill in, `chmod 600`.
# NEVER commit the filled-in file. The app refuses to start if JWT_SECRET is missing, short, or the old default.

DOMAIN=chat.example.com
# Images (the deploy job sets IMAGE_TAG to the commit's sha-<short>).
APP_IMAGE=ghcr.io/sanidhya284/dox-app
WEB_IMAGE=ghcr.io/sanidhya284/dox-web
IMAGE_TAG=main
HSTS_SNIPPET=hsts
# TLS issuer (ADR-0011): "staging" (Let's Encrypt staging, untrusted by browsers, no production rate limits) until
# DNS and ports are confirmed; then "default" (Let's Encrypt, ZeroSSL as Caddy's fallback).
ACME_MODE=staging

# Secrets: generate each with `openssl rand -base64 48`.
POSTGRES_PASSWORD=
JWT_SECRET=
REGISTRATION_INVITE_CODE=
# Optional: without it /actuator/prometheus is not exposed (fail closed). It's never public through Caddy anyway.
METRICS_PASSWORD=
# Optional: seeds demo1..demo3 + "Demo room" (public data!). Changing it resets their passwords on the next start.
DEMO_PASSWORD=
